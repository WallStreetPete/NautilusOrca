# ---------------------------------------------------------------------------
# Black Orca Capital — environment variables
# Copy to .env and fill in. .env is gitignored.
# ---------------------------------------------------------------------------

# Runtime profile: dev | paper | live
BLACKORCA_PROFILE=dev

# Storage backend for the data catalog: local path or s3:// URI
BLACKORCA_CATALOG_PATH=data/catalog

# --- API keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Market data (optional)
DATABENTO_API_KEY=

# Broker (optional, required for paper/live)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Postgres for agent memory (pgvector)
DATABASE_URL=postgresql://blackorca:blackorca@localhost:5432/blackorca

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Observability
PROMETHEUS_METRICS_PORT=9100
LOG_LEVEL=INFO
LOG_JSON=true
